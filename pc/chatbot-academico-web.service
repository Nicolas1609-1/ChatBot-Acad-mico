[Unit]
Description=Chatbot academico de Sistemas - web privada
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nicolas/chatbot-academico/pc
EnvironmentFile=/home/nicolas/chatbot-academico/deploy/app.env
ExecStart=/usr/bin/python3 /home/nicolas/chatbot-academico/pc/server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=default.target
