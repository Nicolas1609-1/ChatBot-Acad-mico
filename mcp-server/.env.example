# Rellenar solo en el servidor, nunca enviar estos valores al chat.
DATABASE_URL=postgresql://mcp_reader:REEMPLAZAR@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgres_ca
# SHA-256 hexadecimal de un token aleatorio de al menos 32 caracteres.
MCP_TOKEN_SHA256=REEMPLAZAR_CON_HASH_SHA256
MCP_HOST=127.0.0.1
MCP_PORT=9000
